	partition FactAlerts = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents("C:\YourRepository\data\alerts_log.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Typed = Table.TransformColumnTypes(Headers, {{"Timestamp", type datetime}, {"Batch_ID", type text}, {"Anomaly_Type", type text}, {"Target_Variable", type text}, {"Metric_Value", type number}, {"Threshold_Reference", type number}, {"Severity_Level", type text}, {"Message", type text}}, "en-US")
				in
				    Typed
